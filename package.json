    "dry": "node src/cli.js --dry-run",
    "print": "node src/cli.js --print"
  },
  "keywords": [
    "timezone",
    "ip",
    "geolocation",
    "tzutil",
    "vpn",
    "proxy",
    "claude",
    "fingerprint",
